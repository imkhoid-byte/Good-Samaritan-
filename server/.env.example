# Local development (uses local SQLite file when TURSO vars not set)
PORT=5000
JWT_SECRET=change-me-in-production

# Turso cloud database (required for Netlify / production)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Set to your Netlify site URL (used to generate QR code links)
# Netlify sets $URL automatically, so this is optional in production
BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Optional notifications (logged to the console when unset)
# Email: Premium owners get instant found alerts; venue guests get tag updates
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
# SMS for venue tag owners
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Where new partner inquiries are emailed
PARTNERS_EMAIL=
